local function _appendMissingDataNames(target, source)
    local present = {}
    for _, name in ipairs(target) do present[name] = true end
    local missing = {}
    for name in pairs(source) do
        if type(name) == "string" and not present[name] then
            table.insert(missing, name)
        end
    end
    table.sort(missing)
    for _, name in ipairs(missing) do
        table.insert(target, name)
    end
end

local function _iconAsset(value)
    if type(value) == "number" then
        return "rbxassetid://"..tostring(value)
    end
    if type(value) == "string" then
        if value:match("^rbxassetid://") then return value end
        if value:match("^%d+$") then return "rbxassetid://"..value end
        return value
    end
    return nil
end

