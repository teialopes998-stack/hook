-- Different model path from the original King script: resolve through the
-- game's BrainrotAssets provider first, then use the replicated cache only
-- as a compatibility fallback.
local function AcquireVisualAnimalModel(animalName)
    local model = nil
    if BrainrotAssets and type(BrainrotAssets.getModel) == "function" then
        pcall(function()
            local resolved = BrainrotAssets.getModel(animalName)
            if resolved and resolved:IsA("Model") then
                model = resolved:Clone()
            end
        end)
    end
    if not model then
        local cached = RS:FindFirstChild("Models")
            and RS.Models:FindFirstChild("Animals")
            and RS.Models.Animals:FindFirstChild(animalName)
        if cached then model = cached:Clone() end
    end
    if model then model:SetAttribute("KVModelMethod", "BrainrotAssetsProvider") end
    return model
end

