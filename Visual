-- Carbon Visuals uses a strict monochrome UI.  Keeping this conversion in one
-- place also catches colours inherited from cloned game templates.
local function CarbonColor(color)
    if typeof(color) ~= "Color3" then return color end
    local luminance = math.clamp(
        math.floor((color.R * 0.2126 + color.G * 0.7152 + color.B * 0.0722) * 255 + 0.5),
        0,
        255
    )
    return Color3.fromRGB(luminance, luminance, luminance)
end

local CARBON_COLOR_PROPERTIES = {
    "BackgroundColor3", "BorderColor3", "TextColor3", "PlaceholderColor3",
    "ImageColor3", "ScrollBarImageColor3", "Color",
}

local function IsCarbonThemeExcluded(object)
    local current = object
    while current do
        local excluded = false
        pcall(function() excluded = current:GetAttribute("CarbonThemeExcluded") == true end)
        if excluded then return true end
        current = current.Parent
    end
    return false
end

local CARBON_SCREEN_NAMES = {
    CarbonVisuals = true,
    KV_TradeSetupPopOut = true,
    KV_SignEditor = true,
}

local function IsCarbonInterfaceObject(object)
    local current = object
    while current do
        if current:IsA("ScreenGui") then
            return CARBON_SCREEN_NAMES[current.Name] == true
        end
        current = current.Parent
    end
    return false
end

local function CarbonThemeObject(object)
    if not object then return end
    if not IsCarbonInterfaceObject(object) then return end
    if IsCarbonThemeExcluded(object) then return end
    local alreadyBound = false
    pcall(function() alreadyBound = object:GetAttribute("CarbonThemeBound") == true end)
    for _, property in ipairs(CARBON_COLOR_PROPERTIES) do
        pcall(function()
            local current = object[property]
            if typeof(current) == "Color3" then
                object[property] = CarbonColor(current)
                if not alreadyBound then
                    object:GetPropertyChangedSignal(property):Connect(function()
                        local updated = object[property]
                        local monochrome = CarbonColor(updated)
                        if updated ~= monochrome then object[property] = monochrome end
                    end)
                end
            end
        end)
    end
    if object:IsA("UIGradient") then
        local points = {}
        for _, keypoint in ipairs(object.Color.Keypoints) do
            table.insert(points, ColorSequenceKeypoint.new(keypoint.Time, CarbonColor(keypoint.Value)))
        end
        if #points > 0 then object.Color = ColorSequence.new(points) end
    end
    if not alreadyBound then pcall(function() object:SetAttribute("CarbonThemeBound", true) end) end
end

